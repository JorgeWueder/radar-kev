    {
      "id": "28bcbfe5-6760-543b-894e-bcbe8b004097",
      "name": "Lotes EPSS (≤100 CVEs y ≤1900 caracteres)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        20
      ],
      "parameters": {
        "jsCode": "// Lotes de la API de EPSS: la lógica real vive en el backend; esto solo parte la lista de CVEs.\nconst cves = $input.first().json.cves || [];\nconst MAX_N = 100, MAX_CHARS = 1900;\nconst batches = [];\nlet cur = [], size = 0;\nfor (const cve of cves) {\n  const add = cve.length + (cur.length ? 1 : 0);\n  if (cur.length && (cur.length >= MAX_N || size + add > MAX_CHARS)) { batches.push(cur); cur = []; size = 0; }\n  cur.push(cve);\n  size += cve.length + (cur.length > 1 ? 1 : 0);\n}\nif (cur.length) batches.push(cur);\nreturn batches.map((b) => ({ json: { cves: b.join(','), n: b.length } }));\n"
      }
    },
