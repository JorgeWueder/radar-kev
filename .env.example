# ============================================================
# Radar de explotación activa (KEV/EPSS) — variables de entorno
# Copia este archivo a .env y genera los secretos con:
#   powershell -File scripts/gen-secrets.ps1   (Windows)
#   sh scripts/gen-secrets.sh                  (Linux/macOS)
# NUNCA subas .env al repositorio.
# ============================================================

# --- PostgreSQL (un contenedor, tres bases aisladas) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
RADAR_DB_PASSWORD=CHANGE_ME        # rol radar_app -> base radar
N8N_DB_PASSWORD=CHANGE_ME          # rol n8n -> base n8n
LANGFLOW_DB_PASSWORD=CHANGE_ME     # rol langflow -> base langflow

# --- Backend ---
ENVIRONMENT=development            # development | production
JWT_SECRET=CHANGE_ME               # >= 32 caracteres aleatorios
FERNET_KEY=CHANGE_ME               # clave Fernet (base64 urlsafe de 32 bytes) para cifrar integraciones
RADAR_SERVICE_KEY=CHANGE_ME        # API key que usa n8n en /internal/*
FRONTEND_ORIGIN=http://localhost:8080   # único origen permitido por CORS
SEED_ON_START=true                 # carga usuarios/inventario de demostración
TZ_UI=America/Lima

# --- Fuentes externas (verificadas el 2026-11-03) ---
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=                       # opcional; sube el límite de uso de NVD

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME
GENERIC_TIMEZONE=America/Lima
N8N_PORT=5678

# --- LangFlow ---
LANGFLOW_PORT=7860
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME
LANGFLOW_API_KEY=                  # clave de API de LangFlow que usa el backend
LANGFLOW_ENRICH_FLOW_ID=           # id del flow ticket_enrichment tras importarlo

# --- IA (el proveedor es intercambiable) ---
LLM_PROVIDER=none                  # anthropic | openai | ollama | none
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Alertas ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=radar@localhost
ALERT_EMAIL_TO=seguridad@localhost
ALERT_WEBHOOK_URL=                 # Slack/Teams/Telegram (opcional)

# --- Puertos publicados en el host ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

SEED_DEMO_PASSWORD=Radar-Demo-2026!   # contrasena de los 4 usuarios semilla (solo demostracion)
TRUST_PROXY_HEADERS=true             # detras de nginx: usa X-Forwarded-For para la IP de bitacora
