# ============================================================
# Radar de explotación activa (KEV/EPSS) — variables de entorno
# Copia este archivo a .env y genera los secretos con:
#   powershell -File scripts/gen-secrets.ps1   (Windows)
#   sh scripts/gen-secrets.sh                  (Linux/macOS)
# NUNCA subas .env al repositorio.
# ============================================================

# --- PostgreSQL (un contenedor, tres bases aisladas) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
RADAR_DB_PASSWORD=CHANGE_ME        # rol radar_app -> base radar
N8N_DB_PASSWORD=CHANGE_ME          # rol n8n -> base n8n
LANGFLOW_DB_PASSWORD=CHANGE_ME     # rol langflow -> base langflow

# --- Backend ---
# development | production. En production: cookie Secure, HSTS y Swagger desactivado (ENABLE_DOCS_EXPLICIT=true lo habilita).
ENVIRONMENT=development
JWT_SECRET=CHANGE_ME               # >= 32 caracteres aleatorios
FERNET_KEY=CHANGE_ME               # clave Fernet (base64 urlsafe de 32 bytes) para cifrar integraciones
RADAR_SERVICE_KEY=CHANGE_ME        # API key que usa n8n en /internal/*
FRONTEND_ORIGIN=http://localhost:8080   # único origen permitido por CORS
SEED_ON_START=true                 # carga usuarios/inventario de demostración
TZ_UI=America/Lima

# --- Fuentes externas (verificadas el 2026-11-03) ---
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# opcional; sube el límite de uso de NVD
NVD_API_KEY=

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME
GENERIC_TIMEZONE=America/Lima
N8N_PORT=5678

# --- LangFlow ---
LANGFLOW_PORT=7860
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME
# clave de API de LangFlow que usa el backend
LANGFLOW_API_KEY=
LANGFLOW_ENRICH_FLOW=ticket-enrichment   # nombre de endpoint del flow (langflow/flows/ticket_enrichment.json)

# --- IA (el proveedor es intercambiable) ---
LLM_PROVIDER=ollama                # ollama (local, por defecto) | anthropic | openai | none
LLM_MODEL=qwen2.5:3b               # modelo de Ollama (con tool calling); con anthropic p. ej. claude-sonnet-5-5
LLM_TIMEOUT=120
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Alertas ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=radar@localhost
ALERT_EMAIL_TO=seguridad@radar.local
# Slack/Teams/Telegram (opcional)
ALERT_WEBHOOK_URL=

# --- Puertos publicados en el host ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

SEED_DEMO_PASSWORD=Radar-Demo-2026!   # contrasena de los 4 usuarios semilla (solo demostracion)
TRUST_PROXY_HEADERS=true             # detras de nginx: usa X-Forwarded-For para la IP de bitacora

APP_URL=http://localhost:8080          # enlace que llevan los correos de alerta
N8N_WEBHOOK_URL=http://n8n:5678/webhook/radar-manual   # lo invoca el boton "Ejecutar ahora"

# --- Docker Compose ---
COMPOSE_PROFILES=ollama            # levanta Ollama y descarga LLM_MODEL; quite "ollama" si usa Anthropic/OpenAI
# COMPOSE_PATH_SEPARATOR=:          # solo Windows nativo (en Windows el separador por defecto es ";")
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml   # descomente para usar GPU NVIDIA con Ollama

LANGFLOW_URL=http://langflow:7860      # el backend consume el flow de enriquecimiento por su API

# Clave de cifrado de LangFlow: debe ser estable entre reinicios (si cambia, se invalidan sus claves de API).
LANGFLOW_SECRET_KEY=CHANGE_ME
